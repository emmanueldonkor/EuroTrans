{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore.Database.Command": "Warning",
      "EuroTrans": "Information",
      "EuroTrans.Infrastructure.Services.MemoryQueryCache": "Debug"
    }
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore.Database.Command": "Warning",
        "EuroTrans": "Information",
        "EuroTrans.Infrastructure.Services.MemoryQueryCache": "Debug"
      }
    },
    "Enrich": [
      "FromLogContext"
    ],
    "WriteTo": [
      {
        "Name": "Console"
      },
      {
        "Name": "File",
        "Args": {
          "path": "logs/eurotrans-.log",
          "rollingInterval": "Day",
          "retainedFileCountLimit": 7,
          "shared": true
        }
      }
    ]
  },
  "RequestLogging": {
    "SlowRequestThresholdMs": 1500
  },
  "RateLimiting": {
    "ReadPermitLimit": 300,
    "WritePermitLimit": 120,
    "TrackingPermitLimit": 600,
    "ReadWindowSeconds": 60,
    "WriteWindowSeconds": 60,
    "TrackingWindowSeconds": 60,
    "QueueLimit": 0
  },
  "Cors": {
    "AllowedOrigins": [
      "http://localhost:3000"
    ]
  },
  "ConnectionStrings": {
    "Default": "Host=localhost;Port=5432;Database=eurotrans;Username=postgres;Password=postgres"
  },
  "Diagnostics": {
    "ExposeExceptionDetails": true
  }
}
