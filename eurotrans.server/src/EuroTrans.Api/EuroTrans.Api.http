@driverToken = <PASTE_DRIVER_TOKEN_AFTER_ASSIGNMENT>
@driverId = <PASTE_DRIVER_EMPLOYEE_ID>
@truckId = <PASTE_TRUCK_ID>

### 1) Create Shipment (manager + write:shipments)
# @name createShipment
POST {{EuroTrans.Api_HostAddress}}/api/shipments
Content-Type: application/json
Accept: application/json
Authorization: Bearer {{managerToken}}

{
  "cargo": {
    "description": "Consumer electronics",
    "weight": 4.5,
    "volume": 2.2
  },
  "origin": {
    "addressLine": "123 Main St",
    "city": "Warsaw",
    "country": "Poland",
    "postalCode": "00-001"
  },
  "destination": {
    "addressLine": "456 Market Ave",
    "city": "Berlin",
    "country": "Germany",
    "postalCode": "10115"
  },
  "estimatedDeliveryDate": "2026-03-01T11:44:59.482Z"
}

### Created shipment ID from step 1
@shipmentId = {{createShipment.response.body.id}}

### 2) List Shipments (manager + read:shipments)
GET {{EuroTrans.Api_HostAddress}}/api/shipments?page=1&pageSize=20
Accept: application/json
Authorization: Bearer {{managerToken}}

### 3) Get Drivers (manager + read:employees)
GET {{EuroTrans.Api_HostAddress}}/api/drivers
Accept: application/json
Authorization: Bearer {{managerToken}}

### 4) Get Trucks (manager + read:trucks)
GET {{EuroTrans.Api_HostAddress}}/api/trucks
Accept: application/json
Authorization: Bearer {{managerToken}}

### 5) Assign Shipment (manager + write:shipments)
POST {{EuroTrans.Api_HostAddress}}/api/shipments/{{shipmentId}}/assign
Content-Type: application/json
Accept: application/json
Authorization: Bearer {{managerToken}}

{
  "driverId": "{{driverId}}",
  "truckId": "{{truckId}}"
}

### 6) Start Shipment (driver + write:shipments)
POST {{EuroTrans.Api_HostAddress}}/api/shipments/{{shipmentId}}/start
Accept: application/json
Authorization: Bearer {{driverToken}}

### 7) Deliver Shipment (driver + write:shipments)
POST {{EuroTrans.Api_HostAddress}}/api/shipments/{{shipmentId}}/deliver
Authorization: Bearer {{driverToken}}
Content-Type: multipart/form-data; boundary=WebAppBoundary

--WebAppBoundary
Content-Disposition: form-data; name="file"; filename="pod.txt"
Content-Type: text/plain

Proof of delivery sample file.
--WebAppBoundary--

### 8) Get Shipment Details (manager or assigned driver + read:shipments)
GET {{EuroTrans.Api_HostAddress}}/api/shipments/{{shipmentId}}
Accept: application/json
Authorization: Bearer {{managerToken}}
