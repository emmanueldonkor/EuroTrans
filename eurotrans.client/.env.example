# Auth0 (Next.js 16, @auth0/nextjs-auth0 v4)
AUTH0_SECRET=replace-with-32-byte-random-value
APP_BASE_URL=http://localhost:3000
AUTH0_DOMAIN=your-tenant.us.auth0.com
AUTH0_CLIENT_ID=your-client-id
AUTH0_CLIENT_SECRET=your-client-secret
AUTH0_AUDIENCE=https://eurotrans.api
AUTH0_SCOPE=openid profile email offline_access read:shipments write:shipments read:trucks write:trucks read:employees write:employees

# Backend URL used by app/api/backend proxy route
EUROTRANS_API_BASE_URL=http://localhost:5002
